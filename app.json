{
  "expo": {
    "name": "Growmo",
    "slug": "growmo",
    "scheme": "growmo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.growmo.app"
    },
    "android": {
      "package": "com.growmo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Growmo uses your camera so you can take hair progress photos for your private Vault.",
          "photosPermission": "Growmo accesses your photos so you can import hair progress photos into your private Vault.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "expo-camera",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "growmo",
          "organization": "not-applicable-ah"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6f766835-d5c2-4e70-885c-50f2dec0fe0c"
      }
    }
  }
}
